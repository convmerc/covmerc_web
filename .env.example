# Firebase (required) — project: convmerc-baeef
NEXT_PUBLIC_FIREBASE_API_KEY=
# Must match Firebase console → Authentication → Settings → Authorized domains base host
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=convmerc-baeef.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=convmerc-baeef
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Site (must match an Firebase Auth authorized domain; used in password-reset emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Covmerc mobile app (vendor registration happens in the app)
NEXT_PUBLIC_COVMERC_IOS_APP_URL=
NEXT_PUBLIC_COVMERC_ANDROID_APP_URL=

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_CALLBACK_URL=http://localhost:3000/checkout?paystack=verify

# Order confirmation emails (Resend)
RESEND_API_KEY=re_your_resend_api_key
ORDER_EMAIL_FROM=Covmerc <orders@covmerc.com>
ORDER_NOTIFICATIONS_TO=support@covmerc.com
